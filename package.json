{
  "name": "dailo",
  "version": "2.0.0-alpha.17",
  "private": true,
  "description": "Dailo: local-first personal productivity app (web/PWA, iPhone and Android through Capacitor).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node tools/check-syntax.mjs",
    "verify": "node tools/check-syntax.mjs && node --test \"tests/*.test.js\"",
    "build": "node tools/build-www.mjs",
    "serve": "python3 -m http.server 8080",
    "smoke": "node tools/smoke-boot.mjs",
    "cap:sync": "node tools/build-www.mjs && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "jsdom": "29.1.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  }
}
