<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign R45: the "Navike" widget: the title and count, up to five habits (a tap checks one in) and one line of note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/habits_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_habits_title"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/habits_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9AA3AF"
        android:textSize="12sp" />

    <TextView android:id="@+id/habits_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:paddingTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="#E9EBEF" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/habits_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#E9EBEF" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/habits_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#E9EBEF" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/habits_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#E9EBEF" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/habits_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#E9EBEF" android:textSize="14sp" android:visibility="gone" />

    <TextView
        android:id="@+id/habits_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="@string/widget_open"
        android:textColor="#9AA3AF"
        android:textSize="12sp" />
</LinearLayout>
