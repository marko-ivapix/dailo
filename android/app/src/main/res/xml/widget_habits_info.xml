<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign R45: the "Navike" widget, 3 × 2 cells by default and resizable; the app refreshes it after each change
     and check-in, the system every 30 minutes (so a new day shows "Otvori Dailo" instead of yesterday's habits). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_habits"
    android:previewLayout="@layout/widget_habits"
    android:description="@string/widget_habits_description"
    android:widgetCategory="home_screen" />
