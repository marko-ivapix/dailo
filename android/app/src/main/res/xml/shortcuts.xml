<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign R24: long-press the Dailo icon for Novi zadatak, Danas and Dnevnik. Each opens the app with a
     dailo:// link that the App plugin hands to the web code (appUrlOpen). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="new_task" android:enabled="true" android:icon="@drawable/ic_shortcut_add" android:shortcutShortLabel="@string/shortcut_new_task">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="cloud.ivapix.dailo" android:targetClass="cloud.ivapix.dailo.MainActivity"
            android:data="dailo://new-task" />
    </shortcut>
    <shortcut android:shortcutId="today" android:enabled="true" android:icon="@drawable/ic_shortcut_today" android:shortcutShortLabel="@string/shortcut_today">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="cloud.ivapix.dailo" android:targetClass="cloud.ivapix.dailo.MainActivity"
            android:data="dailo://today" />
    </shortcut>
    <shortcut android:shortcutId="journal" android:enabled="true" android:icon="@drawable/ic_shortcut_journal" android:shortcutShortLabel="@string/shortcut_journal">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="cloud.ivapix.dailo" android:targetClass="cloud.ivapix.dailo.MainActivity"
            android:data="dailo://journal" />
    </shortcut>
</shortcuts>
